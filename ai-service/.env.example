# CivicAI AI Microservice Environment Configuration
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# In production on Render: Set GEMINI_API_KEY as an Environment Variable in the Render Dashboard
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model configuration: gemini-3.5-flash-lite (fast & robust) or gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true

# Reliability & Retry Settings (Exponential backoff with jitter)
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=3
GEMINI_BASE_DELAY_SECONDS=1.0
GEMINI_MAX_DELAY_SECONDS=10.0
GEMINI_JITTER=true

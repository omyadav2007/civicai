# CivicAI Backend Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (comma-separated for multiple origins, e.g. production Vercel URL + local)
CLIENT_URL=http://localhost:3000

# Authentication Secret (Generate a strong 32+ character random secret in production)
JWT_SECRET=replace-with-a-secure-random-32-char-secret-in-production
JWT_EXPIRES_IN=7d

# Database Connection (Neon PostgreSQL URL for production)
# For Neon with pooling: DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/civicai_db?sslmode=require&pgbouncer=true"
# For Neon direct connection: DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/civicai_db?sslmode=require"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicai_db?schema=public

# Python AI Microservice URL (e.g. https://civicai-ai-service.onrender.com in production)
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_MS=25000
